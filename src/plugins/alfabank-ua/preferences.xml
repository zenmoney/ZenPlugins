<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen>
    <EditTextPreference
        key="phone"
        obligatory="true"
        title="Номер телефону"
        dialogTitle="Номер телефону"
        positiveButtonText="ОК"
        negativeButtonText="Скасувати"
        summary="||{@s}"
    />
    <EditTextPreference
        key="birthDate"
        title="Дата народження"
        dialogTitle="Дата народження"
        dialogMessage="Формат: рррр-мм-дд"
        inputType="text"
        summary="||{@s}"
        positiveButtonText="ОК"
        negativeButtonText="Скасувати"
        obligatory="true">
    </EditTextPreference>
    <EditTextPreference
        key="startDate"
        obligatory="true"
        inputType="date"
        title="З якої дати завантажувати операції"
        defaultValue="2018-01-01T00:00:00.000Z"
        dialogTitle="Дата початку завантаження"
        dialogMessage="Введіть дату, з якої завантажувати операції"
        positiveButtonText="ОК"
        negativeButtonText="Скасувати"
        summary="|startDate|{@s}"
    />
</PreferenceScreen>
