<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen>
    <EditTextPreference
        key="login"
        obligatory="true"
        title="Telefon numarası"
        dialogTitle="Telefon numarası"
        dialogMessage="Türkiye numaraları için +90 yazmayın; diğer ülkeler için + ve ülke koduyla başlayın"
        positiveButtonText="Tamam"
        negativeButtonText="İptal"
        summary="|Telefon numarası|{@s}"
    />
    <EditTextPreference
        key="password"
        obligatory="true"
        inputType="textPassword"
        title="Şifre"
        dialogTitle="Şifre"
        dialogMessage="Altı haneli şifre"
        positiveButtonText="Tamam"
        negativeButtonText="İptal"
        summary="||******"
    />
    <EditTextPreference
        key="startDate"
        obligatory="true"
        inputType="date"
        title="İşlemlerin başlangıç tarihi"
        defaultValue="2018-01-01T00:00:00.000Z"
        dialogTitle="İşlemlerin başlangıç tarihi"
        positiveButtonText="Tamam"
        negativeButtonText="İptal"
        summary="|startDate|{@s}"
    />
</PreferenceScreen>
