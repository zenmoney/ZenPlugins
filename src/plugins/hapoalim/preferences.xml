<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen>
    <ListPreference
        key="authenticationMethod"
        title="שיטת כניסה"
        dialogTitle="שיטת כניסה"
        entries="כניסה ישירה|כניסה בחלון הבנק"
        entryValues="direct|web"
        defaultValue="web"
        positiveButtonText="בסדר"
        negativeButtonText="בטל"
        summary="||{@s}"
    />
    <EditTextPreference
        key="startDate"
        obligatory="true"
        inputType="date"
        title="מאיזה תאריך לטעון פעולות"
        defaultValue="2018-01-01T00:00:00.000Z"
        dialogTitle="מאיזה תאריך לטעון פעולות"
        positiveButtonText="בסדר"
        negativeButtonText="בטל"
        summary="|startDate|{@s}"
    />
</PreferenceScreen>
