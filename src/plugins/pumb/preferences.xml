<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen>
    <EditTextPreference
        key="login"
        inputType="phone"
        title="Номер телефона"
        dialogTitle="Номер телефона"
        dialogMessage="Формат: +380123456789"
        positiveButtonText="ОК"
        negativeButtonText="Отмена"
        summary="|Пример: +380123456789|{@s}"
        obligatory="true">
    </EditTextPreference>
    <EditTextPreference
        key="password"
        title="PIN-код приложения ПУМБ"
        dialogTitle="PIN-код приложения ПУМБ"
        dialogMessage="Введите PIN-код, который используется для входа в приложение ПУМБ. Приложение банка для синхронизации не требуется."
        positiveButtonText="ОК"
        negativeButtonText="Отмена"
        inputType="textPassword"
        summary="||***********"
        obligatory="true">
    </EditTextPreference>
    <EditTextPreference
        key="startDate"
        title="С какой даты загружать операции"
        dialogTitle="С какой даты загружать операции"
        positiveButtonText="ОК"
        negativeButtonText="Отмена"
        inputType="date"
        summary="|гггг-мм-дд|{@s}"
        obligatory="true">
    </EditTextPreference>
</PreferenceScreen>
