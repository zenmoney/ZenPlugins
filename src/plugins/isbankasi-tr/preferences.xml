<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen>
    <EditTextPreference
        key="login"
        obligatory="true"
        inputType="number"
        title="Müşteri numarası / T.C. kimlik numarası"
        dialogTitle="Müşteri numarası / T.C. kimlik numarası"
        positiveButtonText="Tamam"
        negativeButtonText="İptal"
        summary="||{@s}"
    />
    <EditTextPreference
        key="password"
        obligatory="true"
        inputType="textPassword"
        title="Şifre"
        positiveButtonText="Tamam"
        negativeButtonText="İptal"
        summary="||***********"
    />
    <EditTextPreference
        key="startDate"
        obligatory="true"
        inputType="date"
        title="İşlemlerin yükleneceği başlangıç tarihi"
        defaultValue="2022-01-01T00:00:00.000Z"
        dialogTitle="Başlangıç tarihi"
        dialogMessage="İşlemlerin yükleneceği başlangıç tarihini seçin"
        positiveButtonText="Tamam"
        negativeButtonText="İptal"
        summary="|startDate|{@s}"
    />
</PreferenceScreen>
