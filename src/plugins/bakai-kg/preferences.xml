<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen>
    <EditTextPreference
        key="phone"
        obligatory="true"
        inputType="phone"
        title="Номер телефона BakAi"
        dialogTitle="Номер телефона"
        dialogMessage="Введите номер с кодом страны, только цифры, без знака +."
        positiveButtonText="ОК"
        negativeButtonText="Отмена"
        summary="|Номер телефона BakAi|********"
    />
    <EditTextPreference
        key="countryCode"
        obligatory="true"
        defaultValue="RU"
        title="Страна номера телефона"
        dialogTitle="Страна номера телефона"
        dialogMessage="Двухбуквенный код страны номера, выбранной при входе в BakAi. Для российского номера — RU."
        positiveButtonText="ОК"
        negativeButtonText="Отмена"
        summary="|Страна номера телефона|{@s}"
    />
    <EditTextPreference
        key="password"
        obligatory="true"
        inputType="textPassword"
        title="Пароль BakAi"
        dialogTitle="Пароль BakAi"
        dialogMessage="Введите пароль входа в BakAi, а не короткий код разблокировки приложения."
        positiveButtonText="ОК"
        negativeButtonText="Отмена"
        summary="||********"
    />
    <EditTextPreference
        key="startDate"
        obligatory="true"
        inputType="date"
        defaultValue="2026-04-16T00:00:00.000+06:00"
        title="С какой даты загружать операции"
        dialogTitle="Начало истории"
        positiveButtonText="ОК"
        negativeButtonText="Отмена"
        summary="|Начало истории|{@s}"
    />
</PreferenceScreen>
