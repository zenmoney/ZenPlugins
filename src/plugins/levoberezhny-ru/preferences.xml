<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen>
    <EditTextPreference
        key="login"
        obligatory="true"
        title="Логин интернет-банка"
        dialogTitle="Логин интернет-банка"
        positiveButtonText="ОК"
        negativeButtonText="Отмена"
        summary="||{@s}"
    />
    <EditTextPreference
        key="password"
        obligatory="true"
        inputType="textPassword"
        title="Пароль от интернет-банка"
        dialogTitle="Пароль от интернет-банка"
        positiveButtonText="ОК"
        negativeButtonText="Отмена"
        summary="||***********"
    />
    <EditTextPreference
        key="startDate"
        obligatory="true"
        inputType="date"
        title="С какой даты загружать операции"
        dialogMessage="Поддерживаются открытые текущие счета без карт и счета с незакрытыми банковскими картами. Закрытые счета без карт, кредиты и вклады не загружаются."
        defaultValue="2026-01-01T00:00:00.000+03:00"
        dialogTitle="С какой даты загружать операции"
        positiveButtonText="OK"
        negativeButtonText="Cancel"
        summary="|startDate|{@s}"
    />
</PreferenceScreen>
