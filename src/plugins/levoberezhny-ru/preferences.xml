<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen>
    <EditTextPreference
        key="login"
        obligatory="true"
        title="Логин интернет-банка"
        dialogTitle="Логин интернет-банка"
        positiveButtonText="ОК"
        negativeButtonText="Отмена"
        summary="||{@s}"
    />
    <EditTextPreference
        key="password"
        obligatory="true"
        inputType="textPassword"
        title="Пароль от интернет-банка"
        dialogTitle="Пароль от интернет-банка"
        positiveButtonText="ОК"
        negativeButtonText="Отмена"
        summary="||***********"
    />
    <EditTextPreference
        key="startDate"
        obligatory="true"
        inputType="date"
        title="С какой даты загружать операции"
        dialogMessage="Поддерживаются открытые текущие счета без карт, счета с незакрытыми банковскими картами и вклады. История вкладов загружается с выбранной даты. Уже закрытые вклады пропускаются, если плагин не выдавал их ранее, независимо от доступности истории. Кредиты пока не поддерживаются."
        defaultValue="2026-01-01T00:00:00.000+03:00"
        dialogTitle="С какой даты загружать операции"
        positiveButtonText="ОК"
        negativeButtonText="Отмена"
        summary="|startDate|{@s}"
    />
</PreferenceScreen>
