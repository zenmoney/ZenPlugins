<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen>
    <EditTextPreference
        key="login"
        obligatory="true"
        title="Kullanıcı adı"
        dialogTitle="Kullanıcı adı veya T.C. kimlik numarası"
        dialogMessage="Kullanıcı adınızı internet bankacılığının kişisel bilgiler bölümünde bulabilirsiniz. T.C. kimlik numaranızı da kullanabilirsiniz."
        positiveButtonText="Tamam"
        negativeButtonText="İptal"
        summary="|Kullanıcı kimliği|{@s}"
    />
    <EditTextPreference
        key="password"
        obligatory="true"
        inputType="textPassword"
        title="MobilDeniz şifresi"
        dialogTitle="MobilDeniz şifresi"
        positiveButtonText="Tamam"
        negativeButtonText="İptal"
        summary="||***********"
    />
    <EditTextPreference
        key="startDate"
        obligatory="true"
        inputType="date"
        title="İşlem geçmişi başlangıç tarihi"
        defaultValue="2022-01-01T00:00:00.000Z"
        dialogTitle="Başlangıç tarihi"
        dialogMessage="İşlemlerin yükleneceği başlangıç tarihini girin"
        positiveButtonText="Tamam"
        negativeButtonText="İptal"
        summary="|startDate|{@s}"
    />
</PreferenceScreen>
